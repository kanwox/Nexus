        android:pathData="M54.0,42.5 C64.0,42.0 74.5,47.0 74.5,58.0 C74.5,68.0 65.5,75.0 54.0,75.0 C42.5,75.0 33.5,68.0 33.5,58.0 C33.5,47.0 44.0,42.0 54.0,42.5 Z"
