<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android-12 counterpart of data_extraction_rules.xml. The app stores proxy
    credentials and the LAN sharing password, so nothing is eligible for backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
