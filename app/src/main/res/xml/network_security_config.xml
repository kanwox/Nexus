<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Cleartext HTTP is deliberately permitted for plain-HTTP subscriptions, remote
         scripts, and LAN proxy targets. Subscriptions usually carry the user's token,
         so the UI should still steer users toward HTTPS endpoints. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
